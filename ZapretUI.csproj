<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Zapret2UI</AssemblyName>
    <RootNamespace>Zapret2UI</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <Version>1.3.0</Version>
    <Product>Zapret2UI</Product>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <!-- Self-contained single-file publish so the user needs nothing installed -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- Compression is deliberately OFF: it trades RAM for disk at a bad rate. Uncompressed assemblies
         are memory-MAPPED out of the exe (file-backed pages the OS can evict); compressed ones must be
         decompressed into private memory at startup. Measured: on a minimal WPF app with these exact
         settings compression cost +100 MB working set / +59 MB private; on THIS app it saved 93.5 MB on
         disk (72.4 MB compressed vs 166.0 MB). So the trade is roughly 1:1 — ~94 MB of download for
         ~100 MB of RAM. This app sits in the tray all day, so the memory side wins. Re-enable only with
         a fresh measurement. -->
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <!-- NB: InvariantGlobalization is NOT usable here — WPF's own font cache
         (MS.Internal.FontCache.MajorLanguages) constructs named CultureInfo("en"/…) and throws
         CultureNotFoundException in invariant mode, crashing every text render. Verified via the
         screenshot harness. (Could be revisited with PredefinedCulturesOnly=false, but needs its own
         WPF-render verification and only saves ~6 MB over compression alone.) -->
    <EnableComHosting>false</EnableComHosting>
    <!-- WPF handles DPI via app.manifest; silence the WinForms-only DPI analyzer -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinForms is only used for the tray NotifyIcon; avoid the global using
         so System.Windows.Application (WPF) is not ambiguous everywhere. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <!-- The protocol/parsing types worth testing (TgProxyProto, MsgSplitter, CfProxyBalancer) are
         internal by design — this opens them to the test assembly only, and ships nothing extra. -->
    <InternalsVisibleTo Include="Zapret2UI.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Color-emoji rendering for WPF (WPF can't draw color emoji natively).
         Provides emoji:TextBlock / emoji:RichTextBox with the bundled Twemoji font. -->
    <PackageReference Include="Emoji.Wpf" Version="0.3.4" />
  </ItemGroup>

  <ItemGroup>
    <!-- RU→EN UI string table, loaded at runtime by Localization/Loc.cs when the language is English.
         Embedded (not a loose file) so it travels inside the single-file exe. WithCulture=false +
         LogicalName are REQUIRED: the ".en." in the name makes MSBuild treat it as an English SATELLITE
         resource (routed to an en\Zapret2UI.resources.dll), where GetManifestResourceStream on the main
         assembly can't see it. These pin it into the main assembly under a fixed name. -->
    <EmbeddedResource Include="Localization\strings.en.json" WithCulture="false"
                      LogicalName="Zapret2UI.Localization.strings.en.json" />
  </ItemGroup>

  <ItemGroup>
    <!-- usque - an open reimplementation of the MASQUE mode of Cloudflare's own WARP client
         (CONNECT-IP over HTTP/3, RFC 9484). Carried inside our exe for the same reason as WireGuard:
         it is wanted precisely where github.com is unreachable.

         Why it is here at all: WireGuard to WARP is blocked at the TRANSPORT level on Russian ISPs -
         the handshake is let through and the data stream is cut, which the engine cannot fix because a
         desync only disguises the first packet of a flow. MASQUE looks like ordinary HTTP/3 on port
         443 and is what the official client uses. Measured on the owner's ISP: all four MASQUE ports
         complete a TLS 1.3 handshake.

         Run in proxy mode, which needs no adapter, no routes and no administrator - so unlike the
         WireGuard path a failure cannot take the machine off the network. MIT, redistributed verbatim
         with LICENSE.txt alongside. -->
    <EmbeddedResource Include="Assets\usque\usque.exe" LogicalName="Zapret2UI.usque.usque.exe" />
    <EmbeddedResource Include="Assets\usque\LICENSE.txt" LogicalName="Zapret2UI.usque.LICENSE.txt" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\app-on.ico" />
    <Resource Include="Assets\donate-qr.png" />
    <!-- Bundled OFL fonts (Hanken Grotesk / Space Grotesk / JetBrains Mono) so the
         redesigned UI renders identically without the user installing anything. -->
    <Resource Include="Assets\Fonts\*.ttf" />
  </ItemGroup>

</Project>
